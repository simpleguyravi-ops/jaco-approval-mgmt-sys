@model EmailSettings
@{ ViewData["Title"] = "Email Configuration"; }
<a class="jaco-back-link" asp-controller="Admin" asp-action="Index">&larr; Back to Administration</a>
<div class="jaco-page-header">
    <div>
        <h1>Email Configuration</h1>
        <p>SMTP settings used by Post-Processing Rules and the Pending Approvals Digest. Changes take effect immediately, no redeploy needed.@(Model.UpdatedAt != default ? $" Last updated {Model.UpdatedAt:dd MMM yyyy HH:mm} UTC" + (string.IsNullOrEmpty(Model.UpdatedByUserName) ? "." : $" by {Model.UpdatedByUserName}.") : "")</p>
    </div>
</div>

<form method="post" action="/EmailSettings/Save" class="jaco-card jaco-card-pad" style="max-width:560px;">
    @Html.AntiForgeryToken()
    <div class="jaco-check-row"><input type="checkbox" name="Enabled" value="true" checked="@Model.Enabled" id="enabled" /><label for="enabled" style="margin:0;font-weight:400;">Enabled &mdash; while off, every send is skipped and logged as "Skipped" in PPF Monitor</label></div>
    <div class="jaco-form-group"><label>SMTP Host</label><input class="jaco-input" name="Host" value="@Model.Host" placeholder="e.g. smtp.office365.com" /></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div class="jaco-form-group"><label>Port</label><input class="jaco-input" type="number" name="Port" value="@Model.Port" /></div>
        <div class="jaco-form-group" style="display:flex;align-items:flex-end;">
            <label style="display:flex;align-items:center;gap:8px;font-weight:400;margin:0;"><input type="checkbox" name="UseTls" value="true" checked="@Model.UseTls" /> Use TLS</label>
        </div>
    </div>
    <div class="jaco-form-group"><label>From Address</label><input class="jaco-input" type="email" name="From" value="@Model.From" placeholder="noreply@yourcompany.com" /></div>
    <div class="jaco-form-group"><label>Username (optional)</label><input class="jaco-input" name="Username" value="@Model.Username" autocomplete="off" /></div>
    <div class="jaco-form-group">
        <label>Password (leave blank to keep current)</label>
        <div class="jaco-password-wrap">
            <input class="jaco-input" type="password" name="Password" autocomplete="new-password" />
            <button type="button" class="jaco-password-toggle" onclick="var i=this.previousElementSibling;var show=i.type==='password';i.type=show?'text':'password';this.textContent=show?'Hide':'Show';">Show</button>
        </div>
        <p style="margin:4px 0 0;font-size:12px;color:var(--jaco-text-muted);">@(string.IsNullOrEmpty(Model.Password) ? "No password saved yet." : "A password is currently saved.")</p>
    </div>
    <button type="submit" class="jaco-btn jaco-btn-primary">Save</button>
</form>

<div class="jaco-card jaco-card-pad" style="max-width:560px;margin-top:16px;">
    <h2 style="font-size:14px;margin-top:0;">Send a Test Email</h2>
    <form method="post" action="/EmailSettings/SendTest" style="display:flex;gap:10px;">
        @Html.AntiForgeryToken()
        <input class="jaco-input" style="margin:0;" type="email" name="testAddress" placeholder="you@yourcompany.com" required />
        <button type="submit" class="jaco-btn jaco-btn-outline">Send Test</button>
    </form>
</div>
