@model MatrixConfigViewModel
@{ ViewData["Title"] = "Matrix Rule"; }
<a class="jaco-back-link" href="~/RoutingRules?approvalTypeId=@Model.ApprovalTypeId">&larr; Back to Rule Builder</a>
<div class="jaco-page-header">
    <div>
        <h1>Matrix Rule &mdash; @ViewBag.ApprovalTypeName</h1>
        <p>Author approver chains for several criteria values at once &mdash; e.g. every Branch, or every Discount Band &times; Branch combination &mdash; on one screen instead of one rule at a time.</p>
    </div>
</div>

<div class="jaco-alert" style="background:var(--jaco-info-bg);color:var(--jaco-info);margin-bottom:16px;max-width:760px;">
    <b>UI preview only right now.</b> You'll see exactly what real routing rules this would create on the last screen &mdash; nothing is saved to live rules from this flow yet.
</div>

<form method="post" action="~/RoutingRules/MatrixGrid">
    @Html.AntiForgeryToken()
    <input type="hidden" name="approvalTypeId" value="@Model.ApprovalTypeId" />
    <datalist id="fieldKeyOptions">
        @foreach (var f in Model.AvailableFields)
        {
            <option value="@f.FieldKey">@f.FieldLabel</option>
        }
    </datalist>

    <div class="jaco-card jaco-card-pad" style="max-width:760px;margin-bottom:16px;">
        <div class="jaco-form-group">
            <label>Matrix Name</label>
            <input name="matrixName" class="jaco-input" placeholder="e.g. Sales Discount by Branch" required />
            <p style="margin:4px 0 0;font-size:12px;color:var(--jaco-text-muted);">Used as the base name for every rule this generates &mdash; e.g. "Sales Discount by Branch - Jeddah".</p>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="jaco-form-group">
                <label>Priority</label>
                <input name="priority" type="number" class="jaco-input" value="@Model.Priority" />
            </div>
            <div class="jaco-form-group" style="display:flex;align-items:flex-end;">
                <label style="display:flex;align-items:center;gap:8px;font-weight:400;margin:0;"><input type="checkbox" name="active" value="true" checked style="width:auto;" /> Active</label>
            </div>
        </div>
    </div>

    <div class="jaco-card jaco-card-pad" style="max-width:760px;margin-bottom:16px;">
        <label style="display:block;font-size:12.5px;font-weight:600;color:var(--jaco-text-muted);margin-bottom:10px;">Column Axis (required) &mdash; each value gets its own approver chain</label>
        <div style="display:grid;grid-template-columns:1fr 2fr;gap:16px;">
            <div class="jaco-form-group">
                <label>Field</label>
                <input name="columnFieldKey" class="jaco-input" list="fieldKeyOptions" placeholder="e.g. branch" required />
            </div>
            <div class="jaco-form-group">
                <label>Values (comma-separated)</label>
                <input name="columnValues" class="jaco-input" placeholder="Jeddah, Dammam, Riyadh" required />
            </div>
        </div>
    </div>

    <div class="jaco-card jaco-card-pad" style="max-width:760px;margin-bottom:16px;">
        <label style="display:block;font-size:12.5px;font-weight:600;color:var(--jaco-text-muted);margin-bottom:10px;">Row Axis (optional) &mdash; leave blank for a single-axis matrix. Splits a numeric field (e.g. a discount percentage) into bands, crossed with every column value above, each with its own approver chain.</label>
        <div style="display:grid;grid-template-columns:1fr 2fr;gap:16px;">
            <div class="jaco-form-group">
                <label>Field</label>
                <input name="rowFieldKey" class="jaco-input" list="fieldKeyOptions" placeholder="e.g. requestedDiscountPercent" />
            </div>
            <div class="jaco-form-group">
                <label>Bands (comma-separated low-high pairs)</label>
                <input name="rowBands" class="jaco-input" placeholder="2-10, 10-25" />
            </div>
        </div>
    </div>

    <div class="jaco-card jaco-card-pad" style="max-width:760px;margin-bottom:16px;">
        <label style="display:block;font-size:12.5px;font-weight:600;color:var(--jaco-text-muted);margin-bottom:10px;">Additional Conditions (optional, apply to every generated rule)</label>
        <div class="jaco-criteria-header"><div>FIELD</div><div>OPERATOR</div><div>VALUE</div></div>
        @for (var i = 0; i < 4; i++)
        {
            <div class="jaco-criteria-row">
                <input name="criteriaFieldKey" class="jaco-input" style="margin:0;" list="fieldKeyOptions" placeholder="e.g. estimatedCost" />
                <select name="criteriaOperator" class="jaco-select">
                    @foreach (var op in RoutingRulesController.Operators)
                    {
                        <option value="@op">@op</option>
                    }
                </select>
                <input name="criteriaValue" class="jaco-input" style="margin:0;" placeholder="e.g. 500" />
            </div>
        }
    </div>

    <button type="submit" class="jaco-btn jaco-btn-primary">Build Grid &rarr;</button>
</form>
