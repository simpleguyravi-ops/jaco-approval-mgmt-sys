@model MatrixGridViewModel
@{
    ViewData["Title"] = "Matrix Rule — Approvers";
    var rowGroups = Model.Cells.Select((c, i) => (Cell: c, Index: i)).GroupBy(x => x.Cell.RowLabel).ToList();
}
<a class="jaco-back-link" href="~/RoutingRules/Matrix?approvalTypeId=@Model.Config.ApprovalTypeId">&larr; Back to Matrix Config</a>
<div class="jaco-page-header">
    <div>
        <h1>@Model.Config.MatrixName &mdash; Approvers</h1>
        <p>One approver chain per cell. The next screen shows exactly what would be created &mdash; still nothing saved to live rules from here.</p>
    </div>
</div>

<form method="post" action="~/RoutingRules/MatrixPreview">
    @Html.AntiForgeryToken()
    <input type="hidden" name="approvalTypeId" value="@Model.Config.ApprovalTypeId" />
    <input type="hidden" name="matrixName" value="@Model.Config.MatrixName" />
    <input type="hidden" name="columnFieldKey" value="@Model.Config.ColumnFieldKey" />
    <input type="hidden" name="rowFieldKey" value="@Model.Config.RowFieldKey" />
    @for (var i = 0; i < Model.Config.Criteria.Count; i++)
    {
        <input type="hidden" name="criteriaFieldKey" value="@Model.Config.Criteria[i].FieldKey" />
        <input type="hidden" name="criteriaOperator" value="@Model.Config.Criteria[i].Operator" />
        <input type="hidden" name="criteriaValue" value="@Model.Config.Criteria[i].ComparisonValue" />
    }

    @foreach (var group in rowGroups)
    {
        @if (!string.IsNullOrEmpty(group.Key))
        {
            <h2 style="font-size:14px;margin:20px 0 10px;">@Model.Config.RowFieldKey: @group.Key</h2>
        }
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin-bottom:10px;">
            @foreach (var (cell, ci) in group)
            {
                <div class="jaco-card jaco-card-pad">
                    <h3 style="font-size:13.5px;margin:0 0 10px;">@Model.Config.ColumnFieldKey: @cell.ColumnValue</h3>
                    <input type="hidden" name="cellRowLabel" value="@cell.RowLabel" />
                    <input type="hidden" name="cellColumnValue" value="@cell.ColumnValue" />
                    @foreach (var level in cell.Levels)
                    {
                        <div style="margin-bottom:10px;">
                            <label style="display:block;font-size:11px;font-weight:700;color:var(--jaco-text-muted);text-transform:uppercase;letter-spacing:.02em;margin-bottom:4px;">Level @level.LevelNo</label>
                            <input type="text" class="jaco-input approver-filter" style="margin:0 0 4px;font-size:12px;padding:6px 10px;" placeholder="Filter by name or department&hellip;" />
                            <select name="cellLevelApprovers[@(ci)_@(level.LevelNo)]" multiple size="4" class="jaco-select approver-select" style="height:auto;font-size:12px;">
                                @foreach (var deptGroup in Model.Users.GroupBy(u => u.Department ?? "Other").OrderBy(g => g.Key))
                                {
                                    <optgroup label="@deptGroup.Key">
                                        @foreach (var user in deptGroup)
                                        {
                                            <option value="@user.Id">@user.DisplayName</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <button type="submit" class="jaco-btn jaco-btn-primary" style="margin-top:12px;">Preview Rules &rarr;</button>
</form>

<script>
document.querySelectorAll('.approver-filter').forEach(function (input) {
    var select = input.nextElementSibling;
    input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        select.querySelectorAll('optgroup').forEach(function (grp) {
            var anyVisible = false;
            grp.querySelectorAll('option').forEach(function (opt) {
                var match = !q || opt.textContent.toLowerCase().includes(q) || grp.label.toLowerCase().includes(q);
                opt.hidden = !match;
                if (match) anyVisible = true;
            });
            grp.hidden = !anyVisible;
        });
    });
});
</script>
