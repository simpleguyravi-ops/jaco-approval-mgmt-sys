@using JACO.Unified.Web.Services
@model RuleFormViewModel
@{ ViewData["Title"] = Model.Rule is null ? "New Routing Rule" : "Edit Routing Rule"; }
<a class="jaco-back-link" href="~/RoutingRules?approvalTypeId=@Model.ApprovalTypeId">&larr; Back to Rule Builder</a>
<div class="jaco-page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>Rules are checked in priority order (lowest first). Leave a criteria row's field blank to skip it; a rule with no criteria matches anything. Leave a level with no approvers checked to skip that level.</p>
    </div>
</div>

<form method="post" action="@(Model.Rule is null ? Context.Request.PathBase + "/RoutingRules/Create" : $"{Context.Request.PathBase}/RoutingRules/Edit/{Model.Rule.Id}")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="approvalTypeId" value="@Model.ApprovalTypeId" />

    <div class="jaco-card jaco-card-pad" style="max-width:760px;margin-bottom:16px;">
        <div style="display:grid;grid-template-columns:1.6fr 1fr;gap:16px;">
            <div class="jaco-form-group">
                <label>Rule Name</label>
                <input name="ruleName" class="jaco-input" value="@Model.Rule?.RuleName" required />
            </div>
            <div class="jaco-form-group">
                <label>Priority</label>
                <input name="priority" type="number" class="jaco-input" value="@(Model.Rule?.Priority ?? Model.DefaultPriority)" />
            </div>
        </div>
        <div class="jaco-check-row">
            <input type="checkbox" name="active" value="true" checked="@(Model.Rule?.Active ?? true)" id="active" />
            <label for="active" style="margin:0;font-weight:400;">Active</label>
        </div>
    </div>

    <div class="jaco-card jaco-card-pad" style="margin-bottom:16px;" id="criteriaCard">
        <label style="display:block;font-size:12.5px;font-weight:600;color:var(--jaco-text-muted);margin-bottom:10px;">Criteria</label>
        <datalist id="fieldKeyOptions">
            @foreach (var f in Model.AvailableFields)
            {
                <option value="@f.FieldKey">@f.FieldLabel</option>
            }
        </datalist>
        <div class="jaco-criteria-header"><div>FIELD</div><div>OPERATOR</div><div>VALUE</div></div>
        @for (var i = 0; i < Model.Criteria.Count; i++)
        {
            <div class="criteria-row" data-row="@i">
                @if (i > 0)
                {
                    <select name="criteriaLogicalOperator" class="jaco-select criteria-join-select" title="How this condition joins the one(s) before it">
                        <option value="AND" selected="@(Model.Criteria[i].LogicalOperator != "OR")">AND</option>
                        <option value="OR" selected="@(Model.Criteria[i].LogicalOperator == "OR")">OR</option>
                    </select>
                }
                <div class="jaco-criteria-row" style="margin:0;flex:1;">
                    <input name="criteriaFieldKey" class="jaco-input" style="margin:0;" list="fieldKeyOptions" value="@Model.Criteria[i].FieldKey" placeholder="e.g. department" />
                    <select name="criteriaOperator" class="jaco-select">
                        @foreach (var op in RoutingRulesController.Operators)
                        {
                            <option value="@op" selected="@(Model.Criteria[i].Operator == op)">@op</option>
                        }
                    </select>
                    <input name="criteriaValue" class="jaco-input" style="margin:0;" value="@Model.Criteria[i].ComparisonValue" placeholder="e.g. IT" />
                </div>
                <span class="criteria-match-indicator" data-row="@i" title="Matches the sample values below?"></span>
            </div>
        }
        <div style="margin-top:4px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
            <button type="button" id="addCriteriaBtn" class="jaco-btn jaco-btn-outline jaco-btn-sm">+ Add Condition</button>
            <button type="button" id="toggleTestBtn" class="jaco-btn jaco-btn-outline jaco-btn-sm">Test This Rule</button>
            @if (Model.Rule is not null)
            {
                <button type="button" id="toggleFlowBtn" class="jaco-btn jaco-btn-outline jaco-btn-sm">Visualize Flow</button>
            }
        </div>
        <div id="criteriaPreview" class="criteria-preview"></div>
    </div>

    <div class="jaco-card jaco-card-pad" style="margin-bottom:16px;" id="testPanel" hidden>
        <label style="display:block;font-size:12.5px;font-weight:600;color:var(--jaco-text-muted);margin-bottom:4px;">Test This Rule</label>
        <p style="font-size:12.5px;color:var(--jaco-text-muted);margin:0 0 10px;">Enter sample values for the fields used above to see which conditions would match before you save.</p>
        <div id="simulatorFields" class="simulator-fields"></div>
        <div id="simulatorResult"></div>
    </div>

    @if (Model.Rule is not null)
    {
        var activeLevels = Model.Levels.Where(l => l.ApproverUserIds.Count > 0).OrderBy(l => l.LevelNo).ToList();
        string? PpfBadge(string eventCode, string label)
        {
            if (!Model.PpfCountsByEvent.TryGetValue(eventCode, out var count)) return null;
            var text = string.IsNullOrEmpty(label) ? $"{count}" : $"{label} ({count})";
            return $"<span class=\"flow-ppf-badge\" title=\"{count} active Post-Processing rule(s) fire on '{eventCode}'\">&#9993; {text}</span>";
        }
        <div class="jaco-card jaco-card-pad" style="margin-bottom:16px;" id="flowPanel" hidden>
            <label style="display:block;font-size:12.5px;font-weight:600;color:var(--jaco-text-muted);margin-bottom:4px;">Visualize Flow</label>
            <p style="font-size:12.5px;color:var(--jaco-text-muted);margin:0 0 16px;">
                How a submission matching this rule moves through approval, and which Post-Processing (email) rules fire at each step.
                Reflects what's currently saved &mdash; save first if you just made changes.
            </p>
            <div class="flow-diagram">
                <div class="flow-caption">@Model.SavedCriteriaSummary</div>

                <div class="flow-node flow-start">
                    <div class="flow-node-title">Submitted</div>
                    <div class="flow-ppf-badges">@Html.Raw(PpfBadge("Created", "Created"))@Html.Raw(PpfBadge("Resubmit", "Resubmit"))</div>
                </div>

                @if (activeLevels.Count == 0)
                {
                    <p style="color:var(--jaco-text-muted);font-size:12.5px;margin-top:16px;text-align:center;">No levels configured yet &mdash; add approvers above to see the rest of the flow.</p>
                }
                @for (var i = 0; i < activeLevels.Count; i++)
                {
                    var level = activeLevels[i];
                    <div class="flow-connector">
                        <span class="flow-connector-arrow">&darr;</span>
                        @Html.Raw(PpfBadge("LevelPending", "LevelPending"))
                    </div>
                    <div class="flow-row">
                        <div class="flow-node flow-level">
                            <div class="flow-node-title">Level @level.LevelNo</div>
                            <div class="flow-node-sub">@level.Mode@(level.Mode == "MINIMUM_COUNT" ? $" ({level.RequiredCount})" : "")</div>
                            <div class="flow-approvers">
                                @foreach (var uid in level.ApproverUserIds)
                                {
                                    var user = Model.Users.FirstOrDefault(u => u.Id == uid);
                                    if (user is not null)
                                    {
                                        <span class="flow-approver"><img src="@IdenticonGenerator.DataUri(user.UserName)" alt="" /> @user.DisplayName</span>
                                    }
                                }
                            </div>
                        </div>
                        <div class="flow-branches">
                            <div class="flow-branch flow-branch-reject">&rarr; Rejected @Html.Raw(PpfBadge("Rejected", ""))</div>
                            <div class="flow-branch flow-branch-sentback">&rarr; Sent Back @Html.Raw(PpfBadge("SentBack", ""))</div>
                        </div>
                    </div>
                }

                @if (activeLevels.Count > 0)
                {
                    <div class="flow-connector"><span class="flow-connector-arrow">&darr;</span></div>
                    <div class="flow-node flow-end">
                        <div class="flow-node-title">Approved</div>
                        <div class="flow-ppf-badges">@Html.Raw(PpfBadge("Approved", "Approved"))@Html.Raw(PpfBadge("Completed", "Completed"))</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="jaco-card jaco-card-pad">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
            <label style="font-size:12.5px;font-weight:600;color:var(--jaco-text-muted);margin:0;">Levels &amp; Approvers</label>
            <label style="font-size:12.5px;color:var(--jaco-text-muted);margin:0;">Number of Approval Levels:
                <input type="number" id="levelCountInput" min="1" max="@Model.Levels.Count" value="@Math.Max(1, Model.Levels.Count(l => l.ApproverUserIds.Count > 0))" class="jaco-input" style="width:70px;display:inline-block;margin-left:6px;" />
            </label>
        </div>
        @for (var i = 0; i < Model.Levels.Count; i++)
        {
            <div class="level-row" data-row="@i" style="border:1px solid var(--jaco-border);border-radius:var(--jaco-radius-sm);padding:14px;margin-bottom:12px;">
                <div style="display:flex;gap:16px;align-items:center;margin-bottom:10px;flex-wrap:wrap;">
                    <strong style="font-size:13px;">Level @(i + 1)</strong>
                    <select name="levelMode" class="jaco-select" style="width:auto;">
                        @foreach (var m in RoutingRulesController.Modes)
                        {
                            <option value="@m" selected="@(Model.Levels[i].Mode == m)">@m</option>
                        }
                    </select>
                    <span style="font-size:12.5px;color:var(--jaco-text-muted);">Required count (MINIMUM_COUNT only):</span>
                    <input name="levelRequiredCount" type="number" class="jaco-input" style="width:70px;margin:0;" value="@Model.Levels[i].RequiredCount" />
                </div>
                <label style="display:block;font-size:12px;color:var(--jaco-text-muted);margin-bottom:6px;">Approvers</label>
                <div class="chip-row" data-chips-for="lvl-@i"></div>
                <div class="picker" data-picker-for="lvl-@i">
                    <input type="text" placeholder="Add an approver&hellip;" autocomplete="off" />
                    <div class="picker-list"></div>
                </div>
                <select name="levelApprovers[@(i + 1)]" id="native-lvl-@i" multiple class="approver-select-native" style="display:none;">
                    @foreach (var group in Model.Users.GroupBy(u => u.Department ?? "Other").OrderBy(g => g.Key))
                    {
                        <optgroup label="@group.Key">
                            @foreach (var user in group)
                            {
                                <option value="@user.Id" data-avatar="@IdenticonGenerator.DataUri(user.UserName)" selected="@Model.Levels[i].ApproverUserIds.Contains(user.Id)">@user.DisplayName</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
        }
    </div>

    <div style="display:flex;gap:10px;margin-top:16px;">
        <button type="submit" class="jaco-btn jaco-btn-primary">Save Rule</button>
        <a class="jaco-btn jaco-btn-outline" href="~/RoutingRules?approvalTypeId=@Model.ApprovalTypeId">Cancel</a>
    </div>
</form>

<script>
(function () {
    var FIELD_LABELS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableFields.Select(f => new { key = f.FieldKey, label = f.FieldLabel })));
    var criteriaRows = Array.from(document.querySelectorAll('.criteria-row'));
    var levelRows = Array.from(document.querySelectorAll('.level-row'));

    function setRowVisible(row, visible) {
        row.style.display = visible ? '' : 'none';
        row.querySelectorAll('input, select').forEach(function (el) { el.disabled = !visible; });
    }
    function showCriteriaCount(n) { criteriaRows.forEach(function (row, i) { setRowVisible(row, i < n); }); }
    function showLevelCount(n) { levelRows.forEach(function (row, i) { setRowVisible(row, i < n); }); }

    var criteriaVisible = Math.max(1, @Model.Criteria.Count(c => !string.IsNullOrWhiteSpace(c.FieldKey)));
    showCriteriaCount(criteriaVisible);
    document.getElementById('addCriteriaBtn').addEventListener('click', function () {
        if (criteriaVisible >= criteriaRows.length) return;
        criteriaVisible++;
        showCriteriaCount(criteriaVisible);
        runSimulation();
    });

    // ---------- Criteria preview + "Test This Rule" simulator ----------
    // Mirrors RoutingService.GroupByPrecedence/Evaluate on the server: standard AND-before-OR
    // precedence, so "A OR B AND C" previews (and evaluates) as "A OR (B AND C)". The operator
    // matching here (evalCondition) is a client-side approximation of RoutingService.Evaluate
    // meant for a quick sanity check, not a byte-for-byte reimplementation of its numeric/date
    // parsing.
    function fieldLabelFor(key) { var f = FIELD_LABELS.find(function (x) { return x.key === key; }); return f ? f.label : key; }

    function currentCriteria() {
        var rows = [];
        criteriaRows.forEach(function (row) {
            if (row.style.display === 'none') return;
            var field = row.querySelector('[name="criteriaFieldKey"]').value.trim();
            var val = row.querySelector('[name="criteriaValue"]').value;
            if (!field || val === '') return;
            var op = row.querySelector('[name="criteriaOperator"]').value;
            var joinSelect = row.querySelector('[name="criteriaLogicalOperator"]');
            rows.push({ index: row.getAttribute('data-row'), field: field, op: op, val: val, join: joinSelect ? joinSelect.value : 'AND' });
        });
        return rows;
    }

    function groupCriteria(rows) {
        var groups = [];
        rows.forEach(function (r) {
            if (groups.length === 0 || r.join === 'OR') groups.push([]);
            groups[groups.length - 1].push(r);
        });
        return groups;
    }

    function buildPreviewText(rows) {
        if (rows.length === 0) return 'This rule matches any request (no conditions).';
        var parts = groupCriteria(rows).map(function (g) {
            var s = g.map(function (r) { return fieldLabelFor(r.field) + ' ' + r.op + ' "' + r.val + '"'; }).join(' AND ');
            return g.length > 1 ? '(' + s + ')' : s;
        });
        return parts.join(' OR ');
    }

    function evalCondition(op, actual, expected) {
        actual = actual || '';
        switch (op) {
            case '=': return actual.toLowerCase() === expected.toLowerCase();
            case '!=': return actual.toLowerCase() !== expected.toLowerCase();
            case 'CONTAINS': return actual.toLowerCase().indexOf(expected.toLowerCase()) !== -1;
            case 'STARTSWITH': return actual.toLowerCase().indexOf(expected.toLowerCase()) === 0;
            case 'ENDSWITH': return actual.toLowerCase().slice(-expected.length) === expected.toLowerCase();
            case 'IN': return expected.split(',').map(function (v) { return v.trim().toLowerCase(); }).indexOf(actual.toLowerCase()) !== -1;
            case '>': case '>=': case '<': case '<=':
                var cmp;
                var an = parseFloat(actual), en = parseFloat(expected);
                if (!isNaN(an) && !isNaN(en) && actual.trim() !== '' && expected.trim() !== '') { cmp = an - en; }
                else {
                    var ad = Date.parse(actual), ed = Date.parse(expected);
                    if (isNaN(ad) || isNaN(ed)) return false;
                    cmp = ad - ed;
                }
                if (op === '>') return cmp > 0;
                if (op === '>=') return cmp >= 0;
                if (op === '<') return cmp < 0;
                return cmp <= 0;
            default: return false;
        }
    }

    var sampleValues = {};
    // Renders one bordered box per OR-group (matching the parenthesized expression above) so
    // it's visually obvious which fields need to ALL match together vs. which are independent
    // alternatives -- a flat list of fields with no grouping was the actual source of confusion
    // reported here, not the underlying AND/OR evaluation (which was already correct). A field
    // reused across more than one group still gets exactly one real input (one submitted value
    // can't be two different things at once); later groups referencing it show a linked note
    // pointing back at it instead of a second, independently-editable copy.
    function renderSimulatorFields(groups) {
        var container = document.getElementById('simulatorFields');
        if (groups.length === 0) { container.innerHTML = '<span class="chip-empty">Add a condition above to test it here.</span>'; return; }
        var focusedKey = document.activeElement && document.activeElement.getAttribute && document.activeElement.getAttribute('data-sim-field');
        container.innerHTML = '';
        var renderedFields = {};
        groups.forEach(function (g, gi) {
            if (gi > 0) {
                var or = document.createElement('div');
                or.className = 'sim-group-or';
                or.textContent = 'OR';
                container.appendChild(or);
            }
            var box = document.createElement('div');
            box.className = 'sim-group';
            var head = document.createElement('div');
            head.className = 'sim-group-head';
            head.innerHTML = '<span class="sim-group-caption">Group ' + (gi + 1) + (g.length > 1 ? ' — all must match' : '') + '</span><span class="sim-group-verdict" data-group-verdict="' + gi + '"></span>';
            box.appendChild(head);

            var fieldsRow = document.createElement('div');
            fieldsRow.className = 'sim-group-fields';
            g.forEach(function (r, ri) {
                if (ri > 0) {
                    var and = document.createElement('span');
                    and.className = 'sim-group-and';
                    and.textContent = 'AND';
                    fieldsRow.appendChild(and);
                }
                if (renderedFields[r.field]) {
                    var refWrap = document.createElement('div');
                    refWrap.className = 'sim-field sim-field-linked';
                    refWrap.innerHTML = '<label>' + fieldLabelFor(r.field) + '</label><span class="sim-field-linked-note">(same value as above)</span>';
                    fieldsRow.appendChild(refWrap);
                    return;
                }
                renderedFields[r.field] = true;
                var wrap = document.createElement('div');
                wrap.className = 'sim-field';
                var label = document.createElement('label');
                label.textContent = fieldLabelFor(r.field);
                var input = document.createElement('input');
                input.className = 'jaco-input';
                input.setAttribute('data-sim-field', r.field);
                input.value = sampleValues[r.field] || '';
                input.addEventListener('input', function () { sampleValues[r.field] = input.value; runSimulation(); });
                wrap.appendChild(label);
                wrap.appendChild(input);
                fieldsRow.appendChild(wrap);
                if (r.field === focusedKey) input.focus();
            });
            box.appendChild(fieldsRow);
            container.appendChild(box);
        });
    }

    function clearMatchIndicators() {
        document.querySelectorAll('.criteria-match-indicator').forEach(function (el) { el.textContent = ''; el.className = 'criteria-match-indicator'; });
    }

    // The expression preview always reflects the criteria as typed -- it's just a readout of
    // what's on the form. The sample-value simulator (fields, per-row match indicators, and
    // verdict) only runs once the user opens "Test This Rule", so nobody sees a red "would NOT
    // match" verdict before they've entered anything to test against.
    var testModeOn = false;
    var testPanel = document.getElementById('testPanel');
    var toggleTestBtn = document.getElementById('toggleTestBtn');

    function runSimulation() {
        var rows = currentCriteria();
        document.getElementById('criteriaPreview').textContent = buildPreviewText(rows);

        if (!testModeOn) { clearMatchIndicators(); return; }

        var groups = groupCriteria(rows);
        renderSimulatorFields(groups);
        clearMatchIndicators();

        var anyGroupTrue = groups.length === 0;
        groups.forEach(function (g, gi) {
            var groupTrue = true;
            g.forEach(function (r) {
                var ok = evalCondition(r.op, sampleValues[r.field] || '', r.val);
                groupTrue = groupTrue && ok;
                var indicator = document.querySelector('.criteria-match-indicator[data-row="' + r.index + '"]');
                if (indicator) { indicator.textContent = ok ? '✓' : '✗'; indicator.className = 'criteria-match-indicator ' + (ok ? 'match-yes' : 'match-no'); }
            });
            if (groupTrue) anyGroupTrue = true;
            var groupVerdict = document.querySelector('[data-group-verdict="' + gi + '"]');
            if (groupVerdict) { groupVerdict.textContent = groupTrue ? '✓' : '✗'; groupVerdict.className = 'sim-group-verdict ' + (groupTrue ? 'match-yes' : 'match-no'); }
        });

        var resultEl = document.getElementById('simulatorResult');
        resultEl.innerHTML = rows.length === 0 ? '' : (anyGroupTrue
            ? '<span class="sim-verdict sim-match">✓ This rule WOULD match these values</span>'
            : '<span class="sim-verdict sim-no-match">✗ This rule would NOT match these values</span>');
    }

    toggleTestBtn.addEventListener('click', function () {
        testModeOn = !testModeOn;
        testPanel.hidden = !testModeOn;
        toggleTestBtn.textContent = testModeOn ? 'Hide Test' : 'Test This Rule';
        runSimulation();
    });

    var toggleFlowBtn = document.getElementById('toggleFlowBtn');
    var flowPanel = document.getElementById('flowPanel');
    if (toggleFlowBtn && flowPanel) {
        toggleFlowBtn.addEventListener('click', function () {
            flowPanel.hidden = !flowPanel.hidden;
            toggleFlowBtn.textContent = flowPanel.hidden ? 'Visualize Flow' : 'Hide Flow';
        });
    }

    document.getElementById('criteriaCard').addEventListener('input', runSimulation);
    document.getElementById('criteriaCard').addEventListener('change', runSimulation);
    runSimulation();

    var levelInput = document.getElementById('levelCountInput');
    showLevelCount(parseInt(levelInput.value, 10) || 1);
    levelInput.addEventListener('input', function () {
        var n = Math.max(1, Math.min(levelRows.length, parseInt(levelInput.value, 10) || 1));
        showLevelCount(n);
    });

    // Approver picker: click-to-toggle chips instead of a native multi-select (which needs
    // Ctrl/Cmd+click to deselect -- confusing enough in practice that it read as broken).
    // The native <select multiple> is kept, just hidden -- it's still what actually submits
    // with the form (levelApprovers[N]), so nothing on the server needed to change; this only
    // keeps its selected options in sync with the chip UI on top of it.
    function initPicker(root) {
        var key = root.getAttribute('data-picker-for');
        var nativeSelect = document.getElementById('native-' + key);
        var chipRow = document.querySelector('[data-chips-for="' + key + '"]');
        var input = root.querySelector('input');
        var list = root.querySelector('.picker-list');

        function renderChips() {
            var selected = Array.from(nativeSelect.selectedOptions);
            if (selected.length === 0) { chipRow.innerHTML = '<span class="chip-empty">No approvers yet</span>'; return; }
            chipRow.innerHTML = '';
            selected.forEach(function (opt) {
                var chip = document.createElement('span');
                chip.className = 'chip';
                chip.innerHTML = '<img class="chip-avatar" src="' + opt.dataset.avatar + '" alt="" /> ' + opt.textContent + ' <button type="button">&times;</button>';
                chip.querySelector('button').addEventListener('click', function () {
                    opt.selected = false;
                    renderChips();
                    renderList();
                });
                chipRow.appendChild(chip);
            });
        }

        function renderList() {
            var q = input.value.trim().toLowerCase();
            list.innerHTML = '';
            Array.from(nativeSelect.querySelectorAll('optgroup')).forEach(function (grp) {
                var opts = Array.from(grp.querySelectorAll('option')).filter(function (o) {
                    return !q || o.textContent.toLowerCase().includes(q) || grp.label.toLowerCase().includes(q);
                });
                if (opts.length === 0) return;
                var label = document.createElement('div');
                label.className = 'picker-group-label';
                label.textContent = grp.label;
                list.appendChild(label);
                opts.forEach(function (opt) {
                    var row = document.createElement('label');
                    row.className = 'picker-option';
                    row.innerHTML = '<input type="checkbox" ' + (opt.selected ? 'checked' : '') + '/> <img class="option-avatar" src="' + opt.dataset.avatar + '" alt="" /> ' + opt.textContent;
                    row.querySelector('input').addEventListener('change', function (e) {
                        opt.selected = e.target.checked;
                        renderChips();
                    });
                    list.appendChild(row);
                });
            });
        }

        renderChips();
        input.addEventListener('focus', function () { root.classList.add('open'); renderList(); });
        input.addEventListener('input', renderList);
    }
    document.querySelectorAll('[data-picker-for]').forEach(initPicker);
    document.addEventListener('click', function (e) {
        document.querySelectorAll('.picker.open').forEach(function (p) { if (!p.contains(e.target)) p.classList.remove('open'); });
    });
})();
</script>

<style>
.criteria-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.criteria-join-select { width: 72px; flex-shrink: 0; }
.criteria-match-indicator { width: 16px; flex-shrink: 0; text-align: center; font-weight: 700; }
.criteria-match-indicator.match-yes { color: var(--jaco-success); }
.criteria-match-indicator.match-no { color: var(--jaco-danger); }
.criteria-preview { font-size: 12.5px; color: var(--jaco-text-muted); font-style: italic; margin-top: 10px; }
.simulator-fields { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
.sim-group { border: 1px solid var(--jaco-border); border-radius: var(--jaco-radius-sm); padding: 10px 12px; }
.sim-group-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
