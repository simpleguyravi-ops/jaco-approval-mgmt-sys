@model RuleFormViewModel
@{ ViewData["Title"] = Model.Rule is null ? "New Routing Rule" : "Edit Routing Rule"; }
<a class="jaco-back-link" href="~/RoutingRules?approvalTypeId=@Model.ApprovalTypeId">&larr; Back to Rule Builder</a>
<div class="jaco-page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>Rules are checked in priority order (lowest first). Leave a criteria row's field blank to skip it; a rule with no criteria matches anything. Leave a level with no approvers checked to skip that level.</p>
    </div>
</div>

<form method="post" action="@(Model.Rule is null ? Context.Request.PathBase + "/RoutingRules/Create" : $"{Context.Request.PathBase}/RoutingRules/Edit/{Model.Rule.Id}")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="approvalTypeId" value="@Model.ApprovalTypeId" />

    <div class="jaco-card jaco-card-pad" style="max-width:760px;margin-bottom:16px;">
        <div style="display:grid;grid-template-columns:1.6fr 1fr;gap:16px;">
            <div class="jaco-form-group">
                <label>Rule Name</label>
                <input name="ruleName" class="jaco-input" value="@Model.Rule?.RuleName" required />
            </div>
            <div class="jaco-form-group">
                <label>Priority</label>
                <input name="priority" type="number" class="jaco-input" value="@(Model.Rule?.Priority ?? Model.DefaultPriority)" />
            </div>
        </div>
        <div class="jaco-check-row">
            <input type="checkbox" name="active" value="true" checked="@(Model.Rule?.Active ?? true)" id="active" />
            <label for="active" style="margin:0;font-weight:400;">Active</label>
        </div>
    </div>

    <div class="jaco-card jaco-card-pad" style="margin-bottom:16px;">
        <label style="display:block;font-size:12.5px;font-weight:600;color:var(--jaco-text-muted);margin-bottom:10px;">Criteria (all must match)</label>
        <datalist id="fieldKeyOptions">
            @foreach (var f in Model.AvailableFields)
            {
                <option value="@f.FieldKey">@f.FieldLabel</option>
            }
        </datalist>
        <div class="jaco-criteria-header"><div>FIELD</div><div>OPERATOR</div><div>VALUE</div></div>
        @for (var i = 0; i < Model.Criteria.Count; i++)
        {
            <div class="criteria-row jaco-criteria-row" data-row="@i">
                <input name="criteriaFieldKey" class="jaco-input" style="margin:0;" list="fieldKeyOptions" value="@Model.Criteria[i].FieldKey" placeholder="e.g. department" />
                <select name="criteriaOperator" class="jaco-select">
                    @foreach (var op in RoutingRulesController.Operators)
                    {
                        <option value="@op" selected="@(Model.Criteria[i].Operator == op)">@op</option>
                    }
                </select>
                <input name="criteriaValue" class="jaco-input" style="margin:0;" value="@Model.Criteria[i].ComparisonValue" placeholder="e.g. IT" />
            </div>
        }
        <button type="button" id="addCriteriaBtn" class="jaco-btn jaco-btn-outline jaco-btn-sm" style="margin-top:4px;">+ Add Condition</button>
    </div>

    <div class="jaco-card jaco-card-pad">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
            <label style="font-size:12.5px;font-weight:600;color:var(--jaco-text-muted);margin:0;">Levels &amp; Approvers</label>
            <label style="font-size:12.5px;color:var(--jaco-text-muted);margin:0;">Number of Approval Levels:
                <input type="number" id="levelCountInput" min="1" max="@Model.Levels.Count" value="@Math.Max(1, Model.Levels.Count(l => l.ApproverUserIds.Count > 0))" class="jaco-input" style="width:70px;display:inline-block;margin-left:6px;" />
            </label>
        </div>
        @for (var i = 0; i < Model.Levels.Count; i++)
        {
            <div class="level-row" data-row="@i" style="border:1px solid var(--jaco-border);border-radius:var(--jaco-radius-sm);padding:14px;margin-bottom:12px;">
                <div style="display:flex;gap:16px;align-items:center;margin-bottom:10px;flex-wrap:wrap;">
                    <strong style="font-size:13px;">Level @(i + 1)</strong>
                    <select name="levelMode" class="jaco-select" style="width:auto;">
                        @foreach (var m in RoutingRulesController.Modes)
                        {
                            <option value="@m" selected="@(Model.Levels[i].Mode == m)">@m</option>
                        }
                    </select>
                    <span style="font-size:12.5px;color:var(--jaco-text-muted);">Required count (MINIMUM_COUNT only):</span>
                    <input name="levelRequiredCount" type="number" class="jaco-input" style="width:70px;margin:0;" value="@Model.Levels[i].RequiredCount" />
                </div>
                <label style="display:block;font-size:12px;color:var(--jaco-text-muted);margin-bottom:6px;">Approvers</label>
                <div class="chip-row" data-chips-for="lvl-@i"></div>
                <div class="picker" data-picker-for="lvl-@i">
                    <input type="text" placeholder="Add an approver&hellip;" autocomplete="off" />
                    <div class="picker-list"></div>
                </div>
                <select name="levelApprovers[@(i + 1)]" id="native-lvl-@i" multiple class="approver-select-native" style="display:none;">
                    @foreach (var group in Model.Users.GroupBy(u => u.Department ?? "Other").OrderBy(g => g.Key))
                    {
                        <optgroup label="@group.Key">
                            @foreach (var user in group)
                            {
                                <option value="@user.Id" selected="@Model.Levels[i].ApproverUserIds.Contains(user.Id)">@user.DisplayName</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
        }
    </div>

    <div style="display:flex;gap:10px;margin-top:16px;">
        <button type="submit" class="jaco-btn jaco-btn-primary">Save Rule</button>
        <a class="jaco-btn jaco-btn-outline" href="~/RoutingRules?approvalTypeId=@Model.ApprovalTypeId">Cancel</a>
    </div>
</form>

<script>
(function () {
    var criteriaRows = Array.from(document.querySelectorAll('.criteria-row'));
    var levelRows = Array.from(document.querySelectorAll('.level-row'));

    function setRowVisible(row, visible) {
        row.style.display = visible ? '' : 'none';
        row.querySelectorAll('input, select').forEach(function (el) { el.disabled = !visible; });
    }
    function showCriteriaCount(n) { criteriaRows.forEach(function (row, i) { setRowVisible(row, i < n); }); }
    function showLevelCount(n) { levelRows.forEach(function (row, i) { setRowVisible(row, i < n); }); }

    var criteriaVisible = Math.max(1, @Model.Criteria.Count(c => !string.IsNullOrWhiteSpace(c.FieldKey)));
    showCriteriaCount(criteriaVisible);
    document.getElementById('addCriteriaBtn').addEventListener('click', function () {
        if (criteriaVisible >= criteriaRows.length) return;
        criteriaVisible++;
        showCriteriaCount(criteriaVisible);
    });

    var levelInput = document.getElementById('levelCountInput');
    showLevelCount(parseInt(levelInput.value, 10) || 1);
    levelInput.addEventListener('input', function () {
        var n = Math.max(1, Math.min(levelRows.length, parseInt(levelInput.value, 10) || 1));
        showLevelCount(n);
    });

    // Approver picker: click-to-toggle chips instead of a native multi-select (which needs
    // Ctrl/Cmd+click to deselect -- confusing enough in practice that it read as broken).
    // The native <select multiple> is kept, just hidden -- it's still what actually submits
    // with the form (levelApprovers[N]), so nothing on the server needed to change; this only
    // keeps its selected options in sync with the chip UI on top of it.
    function initPicker(root) {
        var key = root.getAttribute('data-picker-for');
        var nativeSelect = document.getElementById('native-' + key);
        var chipRow = document.querySelector('[data-chips-for="' + key + '"]');
        var input = root.querySelector('input');
        var list = root.querySelector('.picker-list');

        function renderChips() {
            var selected = Array.from(nativeSelect.selectedOptions);
            if (selected.length === 0) { chipRow.innerHTML = '<span class="chip-empty">No approvers yet</span>'; return; }
            chipRow.innerHTML = '';
            selected.forEach(function (opt) {
                var chip = document.createElement('span');
                chip.className = 'chip';
                chip.innerHTML = opt.textContent + ' <button type="button">&times;</button>';
                chip.querySelector('button').addEventListener('click', function () {
                    opt.selected = false;
                    renderChips();
                    renderList();
                });
                chipRow.appendChild(chip);
            });
        }

        function renderList() {
            var q = input.value.trim().toLowerCase();
            list.innerHTML = '';
            Array.from(nativeSelect.querySelectorAll('optgroup')).forEach(function (grp) {
                var opts = Array.from(grp.querySelectorAll('option')).filter(function (o) {
                    return !q || o.textContent.toLowerCase().includes(q) || grp.label.toLowerCase().includes(q);
                });
                if (opts.length === 0) return;
                var label = document.createElement('div');
                label.className = 'picker-group-label';
                label.textContent = grp.label;
                list.appendChild(label);
                opts.forEach(function (opt) {
                    var row = document.createElement('label');
                    row.className = 'picker-option';
                    row.innerHTML = '<input type="checkbox" ' + (opt.selected ? 'checked' : '') + '/> ' + opt.textContent;
                    row.querySelector('input').addEventListener('change', function (e) {
                        opt.selected = e.target.checked;
                        renderChips();
                    });
                    list.appendChild(row);
                });
            });
        }

        renderChips();
        input.addEventListener('focus', function () { root.classList.add('open'); renderList(); });
        input.addEventListener('input', renderList);
    }
    document.querySelectorAll('[data-picker-for]').forEach(initPicker);
    document.addEventListener('click', function (e) {
        document.querySelectorAll('.picker.open').forEach(function (p) { if (!p.contains(e.target)) p.classList.remove('open'); });
    });
})();
</script>

<style>
.chip-row { display: flex; flex-wrap: wrap; gap: 6px; min-height: 28px; align-items: center; margin-bottom: 6px; }
.chip { display: inline-flex; align-items: center; gap: 6px; background: var(--jaco-navy-900); color: #fff; border-radius: 999px; padding: 4px 7px 4px 11px; font-size: 11.5px; font-weight: 600; }
.chip button { all: unset; cursor: pointer; width: 15px; height: 15px; border-radius: 50%; background: rgba(255,255,255,.18); display: inline-flex; align-items: center; justify-content: center; font-size: 11px; line-height: 1; }
.chip button:hover { background: var(--jaco-orange-600); }
.chip-empty { color: var(--jaco-text-muted); font-size: 12px; font-style: italic; }
.picker { position: relative; max-width: 320px; }
.picker input { width: 100%; padding: 7px 10px; border: 1px solid var(--jaco-border); border-radius: var(--jaco-radius-sm); font-size: 12px; font-family: inherit; }
.picker input:focus { outline: none; border-color: var(--jaco-orange-600); box-shadow: 0 0 0 3px rgba(242,96,12,.12); }
.picker-list { position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #fff; border: 1px solid var(--jaco-border); border-radius: var(--jaco-radius-sm); box-shadow: 0 8px 20px rgba(16,24,40,.12); max-height: 200px; overflow-y: auto; z-index: 20; display: none; }
.picker.open .picker-list { display: block; }
.picker-group-label { font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--jaco-text-muted); padding: 7px 10px 3px; }
.picker-option { display: flex; align-items: center; gap: 8px; padding: 6px 10px; cursor: pointer; font-size: 12px; }
.picker-option:hover { background: var(--jaco-bg); }
.picker-option input { width: auto; margin: 0; }
</style>
