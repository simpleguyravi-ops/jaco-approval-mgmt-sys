@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }
<div class="jaco-page-header">
    <div>
        <h1>Change Password</h1>
        <p>Choose a new password for your account.</p>
    </div>
</div>
<div class="jaco-card jaco-card-pad" style="max-width:420px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="jaco-alert jaco-alert-danger">@Html.ValidationSummary(true, "", new { })</div>
    }
    <form method="post" asp-controller="Account" asp-action="ChangePassword">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="jaco-form-group">
            <label asp-for="CurrentPassword">Current Password</label>
            <div class="jaco-password-wrap">
                <input asp-for="CurrentPassword" type="password" class="jaco-input" />
                <button type="button" class="jaco-password-toggle" onclick="var i=this.previousElementSibling;var show=i.type==='password';i.type=show?'text':'password';this.textContent=show?'Hide':'Show';">Show</button>
            </div>
        </div>
        <div class="jaco-form-group">
            <label asp-for="NewPassword">New Password</label>
            <div class="jaco-password-wrap">
                <input asp-for="NewPassword" type="password" class="jaco-input" />
                <button type="button" class="jaco-password-toggle" onclick="var i=this.previousElementSibling;var show=i.type==='password';i.type=show?'text':'password';this.textContent=show?'Hide':'Show';">Show</button>
            </div>
        </div>
        <div class="jaco-form-group">
            <label asp-for="ConfirmPassword">Confirm New Password</label>
            <div class="jaco-password-wrap">
                <input asp-for="ConfirmPassword" type="password" class="jaco-input" />
                <button type="button" class="jaco-password-toggle" onclick="var i=this.previousElementSibling;var show=i.type==='password';i.type=show?'text':'password';this.textContent=show?'Hide':'Show';">Show</button>
            </div>
        </div>
        <button type="submit" class="jaco-btn jaco-btn-primary">Update Password</button>
    </form>
</div>
