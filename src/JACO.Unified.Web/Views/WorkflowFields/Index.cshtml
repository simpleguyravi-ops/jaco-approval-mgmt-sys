@model List<WorkflowField>
@{
    ViewData["Title"] = "Criteria Fields";
    var types = (List<ApprovalType>)ViewBag.Types;
    int selectedTypeId = ViewBag.SelectedTypeId;
    var sort = (string?)ViewBag.Sort;
    var dir = (string)ViewBag.Dir;
    string SortUrl(string field)
    {
        var newDir = sort == field && dir == "asc" ? "desc" : "asc";
        return $"/WorkflowFields?approvalTypeId={selectedTypeId}&sort={field}&dir={newDir}";
    }
    string SortArrow(string field) => sort != field ? "" : (dir == "asc" ? " &#9650;" : " &#9660;");
}
<a class="jaco-back-link" asp-controller="Admin" asp-action="Index">&larr; Back to Administration</a>
<div class="jaco-page-header">
    <div>
        <h1>Criteria Fields</h1>
        <p>Adding a field here makes it available on the Create/Edit form, the Details panel, and Rule Builder's criteria &mdash; no code change needed. A field added under <b>@GenericApprovalType.Name</b> shows up for every type.</p>
    </div>
    <a class="jaco-btn jaco-btn-primary" href="/WorkflowFields/Create?approvalTypeId=@selectedTypeId">+ New Field</a>
</div>

<div class="lookup-tabs" style="margin-bottom:18px;">
    <a class="lookup-tab @(selectedTypeId == GenericApprovalType.Id ? "selected" : "")" href="/WorkflowFields?approvalTypeId=@GenericApprovalType.Id">@GenericApprovalType.Name</a>
    @foreach (var t in types)
    {
        <a class="lookup-tab @(t.Id == selectedTypeId ? "selected" : "")" href="/WorkflowFields?approvalTypeId=@t.Id">@t.Name</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="jaco-card jaco-card-pad">
        <p style="margin:0;color:var(--jaco-text-muted);">No fields yet for this scope.</p>
    </div>
}
else
{
    <form method="post" action="/WorkflowFields/BulkDelete" id="fieldsForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="approvalTypeId" value="@selectedTypeId" />

        <div id="removeWarning" class="notice" style="display:none;background:var(--jaco-warning-bg, #fef3c7);color:var(--jaco-warning, #b45309);margin-bottom:12px;">
            <span id="removeCount">0</span> field(s) marked for removal &mdash; nothing is deleted until you click <b>Save Changes</b> below, and once saved it cannot be undone.
        </div>

        <div class="jaco-card">
            <table class="jaco-table">
                <thead><tr>
                    <th>Order</th>
                    <th><a class="link" href="@SortUrl("FieldKey")">Key@(Html.Raw(SortArrow("FieldKey")))</a></th>
                    <th><a class="link" href="@SortUrl("FieldLabel")">Label@(Html.Raw(SortArrow("FieldLabel")))</a></th>
                    <th><a class="link" href="@SortUrl("DataType")">Type@(Html.Raw(SortArrow("DataType")))</a></th>
                    <th>Visible</th><th>Read-only</th>
                    <th><a class="link" href="@SortUrl("IsRequired")">Required@(Html.Raw(SortArrow("IsRequired")))</a></th>
                    <th>Sensitive</th><th>Lookup</th><th>Remove?</th>
                </tr></thead>
                <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.DisplayOrder</td>
                        <td><code>@f.FieldKey</code></td>
                        <td><a class="link" href="/WorkflowFields/Edit/@f.Id">@f.FieldLabel</a></td>
                        <td>@f.DataType</td>
                        <td>@(f.IsVisible ? "Yes" : "—")</td>
                        <td>@(f.IsReadOnly ? "Yes" : "—")</td>
                        <td>@(f.IsRequired ? "Yes" : "—")</td>
                        <td>@(f.IsSensitive ? "Yes" : "—")</td>
                        <td>@f.LookupType</td>
                        <td style="text-align:center;"><input type="checkbox" name="ids" value="@f.Id" class="remove-check" onchange="updateRemoveWarning()" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="actions" style="margin-top:16px;">
            <button type="submit" id="saveChangesBtn" class="jaco-btn jaco-btn-primary" disabled>Save Changes</button>
        </div>
    </form>

    <script>
        function updateRemoveWarning() {
            var checked = document.querySelectorAll('.remove-check:checked').length;
            document.getElementById('removeCount').textContent = checked;
            document.getElementById('removeWarning').style.display = checked > 0 ? 'block' : 'none';
            document.getElementById('saveChangesBtn').disabled = checked === 0;
            if (checked > 0) {
                document.getElementById('fieldsForm').setAttribute('data-confirm', checked + ' field(s) will be permanently removed. This cannot be undone. Continue?');
            } else {
                document.getElementById('fieldsForm').removeAttribute('data-confirm');
            }
        }
    </script>
}
