@model WorkflowField
@{
    ViewData["Title"] = "New Criteria Field";
    var types = (List<ApprovalType>?)ViewBag.Types ?? new List<ApprovalType>();
    int currentTypeId = Model.ApprovalTypeId ?? GenericApprovalType.Id;
}
<a class="jaco-back-link" href="~/WorkflowFields?approvalTypeId=@currentTypeId">&larr; Back to Criteria Fields</a>
<div class="jaco-page-header">
    <div>
        <h1>New Criteria Field</h1>
        <p>Field Key is what appears in the DataJson, the Create/Edit form, and Rule Builder's criteria dropdown.</p>
    </div>
</div>
<form method="post" action="~/WorkflowFields/Create" class="jaco-card jaco-card-pad" style="max-width:560px;">
    @Html.AntiForgeryToken()
    <div class="jaco-form-group">
        <label>Scope</label>
        <select name="approvalTypeId" class="jaco-select" required>
            <option value="@GenericApprovalType.Id" selected="@(currentTypeId == GenericApprovalType.Id)">@GenericApprovalType.Name</option>
            @foreach (var t in types)
            {
                <option value="@t.Id" selected="@(t.Id == currentTypeId)">@t.Name</option>
            }
        </select>
    </div>
    <div class="jaco-form-group"><label>Field Key (no spaces, used in DataJson)</label><input class="jaco-input" name="FieldKey" placeholder="e.g. requiredBy" required /></div>
    <div class="jaco-form-group"><label>Label</label><input class="jaco-input" name="FieldLabel" placeholder="e.g. Required By" required /></div>
    <div class="jaco-form-group">
        <label>Data Type</label>
        <select class="jaco-select" name="DataType">
            <option value="Text">Text</option>
            <option value="TextArea">Text Area</option>
            <option value="Number">Number</option>
            <option value="Currency">Currency</option>
            <option value="Date">Date</option>
            <option value="Dropdown">Dropdown</option>
        </select>
    </div>
    <div class="jaco-form-group"><label>Lookup Type (Dropdown only)</label><input class="jaco-input" name="LookupType" placeholder="e.g. Department" /></div>
    <div class="jaco-form-group"><label>Display Order</label><input class="jaco-input" type="number" name="DisplayOrder" value="10" /></div>
    @* checkbox-then-hidden-false pattern: a plain unchecked checkbox posts nothing, and
       IsVisible/Active default to true on WorkflowField, so an unchecked box here would
       otherwise silently fall back to true instead of saving false. *@
    <div class="jaco-check-row"><input type="checkbox" name="IsVisible" value="true" checked id="v" /><input type="hidden" name="IsVisible" value="false" /><label for="v" style="margin:0;font-weight:400;">Visible on form</label></div>
    <div class="jaco-check-row"><input type="checkbox" name="IsReadOnly" value="true" id="ro" /><input type="hidden" name="IsReadOnly" value="false" /><label for="ro" style="margin:0;font-weight:400;">Read-only</label></div>
    <div class="jaco-check-row"><input type="checkbox" name="IsRequired" value="true" id="req" /><input type="hidden" name="IsRequired" value="false" /><label for="req" style="margin:0;font-weight:400;">Required</label></div>
    <div class="jaco-check-row"><input type="checkbox" name="IsSensitive" value="true" id="sens" /><input type="hidden" name="IsSensitive" value="false" /><label for="sens" style="margin:0;font-weight:400;">Sensitive (hidden from creator once submitted)</label></div>
    <div class="jaco-check-row"><input type="checkbox" name="IncludeInApi" value="true" checked id="api" /><input type="hidden" name="IncludeInApi" value="false" /><label for="api" style="margin:0;font-weight:400;">Include in API (accepted on Create, returned on Get)</label></div>
    <div class="jaco-check-row"><input type="checkbox" name="Active" value="true" checked id="act" /><input type="hidden" name="Active" value="false" /><label for="act" style="margin:0;font-weight:400;">Active</label></div>
    <div style="display:flex;gap:10px;margin-top:12px;">
        <button type="submit" class="jaco-btn jaco-btn-primary">Create</button>
        <a class="jaco-btn jaco-btn-outline" href="~/WorkflowFields?approvalTypeId=@currentTypeId">Cancel</a>
    </div>
</form>
