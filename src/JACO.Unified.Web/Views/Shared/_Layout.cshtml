@using JACO.Unified.Web.Controllers
@using JACO.Unified.Web.Services
@inject IConfiguration Configuration
@{
    var path = Context.Request.Path.Value ?? "/";
    bool IsActive(string prefix) => path.Equals(prefix, StringComparison.OrdinalIgnoreCase) || path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
    var isAdmin = User.IsInRole("UNIFIED_ADMIN") || User.IsInRole("PORTAL_ADMIN") || User.IsInRole("SYSTEM_ADMIN");
    var isAuditor = isAdmin || User.IsInRole("UNIFIED_AUDITOR");
    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "";
    var department = User.FindFirst("Department")?.Value;
    // Seeded from the username (stable, unique login identifier) rather than DisplayName --
    // two people can share a display name, but never a login.
    var avatarSeed = User.Identity?.Name ?? displayName;
    // A Unified-only cookie (set from /Themes, see ThemesController) takes precedence once
    // the user has picked one of JAMS' own templates. Until then, fall back to the "Theme"
    // claim Portal writes into the shared SSO cookie (orange/fiori only, platform-wide) so
    // anyone who already picked Fiori there keeps seeing it here without having to repick.
    var cookieTheme = Context.Request.Cookies[ThemesController.CookieName];
    var claimTheme = User.FindFirst("Theme")?.Value == "fiori" ? "fiori" : "orange";
    var theme = ThemeCatalog.IsValid(cookieTheme) ? cookieTheme! : claimTheme;
    var themeSuffix = theme == "orange" ? "" : $".{theme}";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JAMS</title>
    <!-- asp-append-version hashes each file's actual content into a ?v= query string, so a
         CSS edit is guaranteed a new URL and can't silently keep serving a stale cached copy
         to anyone who already has the app open -- these links carry no Cache-Control header,
         so browsers apply heuristic freshness caching and may reuse an old response for a
         long time otherwise. -->
    <link rel="stylesheet" href="~/css/jaco-design-system@(themeSuffix).css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/jaco.css" asp-append-version="true" />
    <script>
    // Applied before the sidebar itself is even parsed, so a collapsed preference never
    // flashes open first -- toggling a class post-render (after the CSS/DOM already painted
    // an expanded sidebar) would show a one-frame jump on every single page load.
    if (localStorage.getItem('jaco-sidebar-collapsed') === '1') {
        document.documentElement.classList.add('sidebar-collapsed');
    }
    </script>
</head>
<body>
    <div class="jaco-shell">
        <header class="jaco-topbar">
            <div class="jaco-topbar-brand">
                <img src="~/img/jaco-logo-color.png" alt="JACO" />
                <div class="divider"></div>
                <div class="wordmark"><span class="jaco-name">JAMS</span> <span class="app-name">Approval System</span></div>
            </div>
            <div class="jaco-user-chip">
                <div class="who">
                    <div class="name">@displayName</div>
                    <div class="role">@(isAdmin ? "Administrator" : "Requestor")@(string.IsNullOrEmpty(department) ? "" : " · " + department)</div>
                    <a class="jaco-theme-link" href="~/Themes" title="Choose a JAMS visual template">
                        <span class="jaco-icon jaco-icon-settings"></span> @ThemeCatalog.Get(theme).Name
                    </a>
                </div>
                <div class="jaco-avatar" title="@displayName" style="background-image:url('@IdenticonGenerator.DataUri(avatarSeed)');background-size:cover;"></div>
            </div>
        </header>
        <div class="jaco-shell-body">
            <aside class="jaco-sidebar">
                <button type="button" id="sidebarToggleBtn" class="jaco-sidebar-toggle" title="Collapse navigation">
                    <span class="jaco-icon jaco-icon-chevron-left"></span>
                </button>
                <ul class="jaco-nav">
                    <li><a class="@((path == "/" || IsActive("/Requests")) ? "active" : "")" href="~/Requests" title="My Work"><span class="jaco-icon jaco-icon-check-square"></span> <span class="jaco-nav-label">My Work</span></a></li>
                    @if (isAuditor)
                    {
                        <li><a class="@(IsActive("/Reports") ? "active" : "")" href="~/Reports" title="Reports"><span class="jaco-icon jaco-icon-chart"></span> <span class="jaco-nav-label">Reports</span></a></li>
                    }
                    @if (isAdmin)
                    {
                        <li><a class="@(IsActive("/Admin") || IsActive("/Cockpit") || IsActive("/Home/PpfMonitor") ? "active" : "")" href="~/Admin" title="Administration"><span class="jaco-icon jaco-icon-settings"></span> <span class="jaco-nav-label">Administration</span></a></li>
                    }
                </ul>
                <div class="jaco-sidebar-footer">
                    <ul class="jaco-nav">
                        <li><a href="~/Account/ChangePassword" title="Change Password"><span class="jaco-icon jaco-icon-key"></span> <span class="jaco-nav-label">Change Password</span></a></li>
                        <li><a href="~/Account/Logout" title="Sign Out"><span class="jaco-icon jaco-icon-signout"></span> <span class="jaco-nav-label">Sign Out</span></a></li>
                    </ul>
                </div>
            </aside>
            <div class="jaco-main">
                <main class="jaco-content">
                    @if (TempData["Success"] is string successMessage)
                    {
                        <div class="notice success">@successMessage</div>
                    }
                    @if (TempData["Error"] is string errorMessage)
                    {
                        <div class="notice error">@errorMessage</div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
    <script src="~/js/jaco-confirm.js"></script>
    <script>
    (function () {
        var btn = document.getElementById('sidebarToggleBtn');
        if (!btn) return;
        btn.addEventListener('click', function () {
            var collapsed = document.documentElement.classList.toggle('sidebar-collapsed');
            localStorage.setItem('jaco-sidebar-collapsed', collapsed ? '1' : '0');
            btn.title = collapsed ? 'Expand navigation' : 'Collapse navigation';
        });
    })();
    </script>
</body>
</html>
