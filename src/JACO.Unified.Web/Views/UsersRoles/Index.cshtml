@using JACO.Unified.Web.Services
@model List<AppUser>
@{
    ViewData["Title"] = "Users & Roles";
    var types = (List<ApprovalType>)ViewBag.Types;
    int approvalTypeId = ViewBag.ApprovalTypeId;
    var perms = (Dictionary<int, UserWorkflowPermission>)ViewBag.Permissions;
}
<a class="jaco-back-link" asp-controller="Admin" asp-action="Index">&larr; Back to Administration</a>
<div class="jaco-page-header">
    <div><h1>Users &amp; Roles</h1><p>"Display All" grants oversight of every request of this type. Creating or being involved in a request is automatic and needs no grant. Add accounts under Administration &rarr; User Accounts first, then grant access here.</p></div>
</div>
<div class="lookup-tabs" style="margin-bottom:18px;">
    @foreach (var t in types)
    {
        <a class="lookup-tab @(t.Id == approvalTypeId ? "selected" : "")" href="~/UsersRoles?approvalTypeId=@t.Id">@t.Name</a>
    }
</div>
<div style="display:flex;justify-content:flex-end;margin-bottom:8px;">
    <a class="jaco-btn jaco-btn-outline jaco-btn-sm" href="~/UsersRoles/Export">Download CSV</a>
</div>
<form method="post" action="~/UsersRoles/Save">
    @Html.AntiForgeryToken()
    <input type="hidden" name="approvalTypeId" value="@approvalTypeId" />
    <div class="jaco-card">
        <table class="jaco-table">
            <thead><tr><th>User</th><th>Department</th><th>Can Create</th><th>Display All</th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                var p = perms.GetValueOrDefault(u.Id);
                <tr>
                    <td>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <img src="@IdenticonGenerator.DataUri(u.UserName)" alt="" style="width:24px;height:24px;border-radius:50%;flex-shrink:0;" />
                            <span>@u.DisplayName <span style="color:var(--jaco-text-muted);">(@u.UserName)</span></span>
                        </div>
                    </td>
                    <td>@u.Department</td>
                    <td><input type="checkbox" name="canCreateUserIds" value="@u.Id" checked="@(p?.CanCreate ?? false)" /></td>
                    <td><input type="checkbox" name="canViewUserIds" value="@u.Id" checked="@(p?.CanView ?? false)" /></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" style="text-align:center;color:var(--jaco-text-muted);">No users yet -- add an account under Administration &rarr; User Accounts first.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <button type="submit" class="jaco-btn jaco-btn-primary" style="margin-top:14px;">Save Permissions</button>
</form>
