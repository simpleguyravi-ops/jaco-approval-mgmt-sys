@model TaskType
@{ ViewData["Title"] = "Edit Task Type"; }
<a class="jaco-back-link" href="~/TaskTypes">&larr; Back to Task Types</a>
<div class="jaco-page-header"><div><h1>Edit @Model.Name</h1></div></div>
<form method="post" action="~/TaskTypes/Edit/@Model.Id" class="jaco-card jaco-card-pad" style="max-width:560px;">
    @Html.AntiForgeryToken()
    <div class="jaco-form-group"><label>Code</label><input class="jaco-input" name="Code" value="@Model.Code" style="text-transform:uppercase;" required /></div>
    <div class="jaco-form-group"><label>Name</label><input class="jaco-input" name="Name" value="@Model.Name" required /></div>
    <div class="jaco-check-row"><input type="checkbox" name="Active" value="true" checked="@Model.Active" id="active" /><input type="hidden" name="Active" value="false" /><label for="active" style="margin:0;font-weight:400;">Active</label></div>
    <div style="display:flex;gap:10px;margin-top:12px;">
        <button type="submit" class="jaco-btn jaco-btn-primary">Save</button>
        <a class="jaco-btn jaco-btn-outline" href="~/TaskTypes">Cancel</a>
    </div>
</form>
