@using JACO.Unified.Core.Models
@{
    var types = (List<ApprovalType>)ViewBag.Types;
    int? selectedTypeId = ViewBag.SelectedTypeId;
    DateTime from = ViewBag.From;
    DateTime to = ViewBag.To;
    var current = (string)ViewContext.RouteData.Values["action"]!;
    string Tab(string action) => current == action ? "selected" : "";
    // Filter (type/date range) carries across tabs; sort/dir is per-report and shouldn't.
    var carryQs = $"approvalTypeId={selectedTypeId}&from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}";
}
<div class="lookup-tabs" style="margin-bottom:14px;">
    <a class="lookup-tab @Tab("Volume")" href="~/Reports/Volume?@carryQs">Volume &amp; Status</a>
    <a class="lookup-tab @Tab("CycleTime")" href="~/Reports/CycleTime?@carryQs">Cycle Time</a>
    <a class="lookup-tab @Tab("Approvers")" href="~/Reports/Approvers?@carryQs">Approver Workload</a>
</div>
<div class="jaco-card jaco-card-pad" style="margin-bottom:16px;">
    <form method="get" action="~/Reports/@current" style="display:grid;grid-template-columns:1.4fr 1fr 1fr auto;gap:12px;align-items:end;">
        <div class="jaco-form-group" style="margin:0;">
            <label>Approval Type</label>
            <select name="approvalTypeId" class="jaco-select" onchange="this.form.requestSubmit()">
                <option value="">All Types</option>
                @foreach (var t in types)
                {
                    <option value="@t.Id" selected="@(selectedTypeId == t.Id)">@t.Name</option>
                }
            </select>
        </div>
        <div class="jaco-form-group" style="margin:0;"><label>From</label><input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="jaco-input" style="margin:0;" /></div>
        <div class="jaco-form-group" style="margin:0;"><label>To</label><input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="jaco-input" style="margin:0;" /></div>
        <button type="submit" class="jaco-btn jaco-btn-outline">Filter</button>
    </form>
</div>
