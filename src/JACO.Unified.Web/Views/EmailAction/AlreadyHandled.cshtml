@model string
@{
    Layout = null;
    ViewData["Title"] = "Already Handled";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Already Handled - JACO Unified</title>
    <link rel="stylesheet" href="~/css/jaco-design-system.css" />
</head>
<body style="background:var(--jaco-bg);min-height:100vh;display:flex;align-items:center;justify-content:center;">
    <div class="jaco-card jaco-card-pad" style="max-width:440px;margin:24px;text-align:center;">
        <img src="~/img/jaco-logo-color.png" alt="JACO" style="height:32px;width:auto;margin-bottom:20px;" />
        <h1 style="font-size:18px;margin:0 0 8px;">Nothing left to do here@(string.IsNullOrEmpty(Model) ? "" : $" for {Model}")</h1>
        <p style="color:var(--jaco-text-muted);font-size:13.5px;margin:0 0 20px;">
            This request has either already been decided (by you or another eligible
            approver), withdrawn, or has moved past the level this link was sent for. Open it
            in JACO Unified to see its current status.
        </p>
        <a class="jaco-btn jaco-btn-primary" href="~/">Go to JACO Unified</a>
    </div>
</body>
</html>
