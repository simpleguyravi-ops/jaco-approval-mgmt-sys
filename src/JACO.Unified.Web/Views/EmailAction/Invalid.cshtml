@{
    Layout = null;
    ViewData["Title"] = "Link Invalid";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Link Invalid - JACO Unified</title>
    <link rel="stylesheet" href="~/css/jaco-design-system.css" />
</head>
<body style="background:var(--jaco-bg);min-height:100vh;display:flex;align-items:center;justify-content:center;">
    <div class="jaco-card jaco-card-pad" style="max-width:440px;margin:24px;text-align:center;">
        <img src="~/img/jaco-logo-color.png" alt="JACO" style="height:32px;width:auto;margin-bottom:20px;" />
        <h1 style="font-size:18px;margin:0 0 8px;">This link is invalid or has expired</h1>
        <p style="color:var(--jaco-text-muted);font-size:13.5px;margin:0 0 20px;">
            One-click approval links expire after 14 days, and each one only works once its
            request is still waiting on the person it was sent to. If you still need to act
            on this request, please open it directly in JACO Unified.
        </p>
        <a class="jaco-btn jaco-btn-primary" href="/">Go to JACO Unified</a>
    </div>
</body>
</html>
