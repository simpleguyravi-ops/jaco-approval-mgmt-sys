@model EmailApproveViewModel
@{
    Layout = null;
    ViewData["Title"] = "Approve Request";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Approve @Model.RequestNumber - JAMS</title>
    <link rel="stylesheet" href="~/css/jaco-design-system.css" asp-append-version="true" />
</head>
<body style="background:var(--jaco-bg);min-height:100vh;display:flex;align-items:center;justify-content:center;">
    <div class="jaco-card jaco-card-pad" style="max-width:440px;margin:24px;">
        <div style="text-align:center;">
            <img src="~/img/jaco-logo-color.png" alt="JACO" style="height:32px;width:auto;margin-bottom:20px;" />
        </div>
        <h1 style="font-size:18px;margin:0 0 4px;">Approve @Model.RequestNumber?</h1>
        @if (!string.IsNullOrEmpty(Model.Subject))
        {
            <p style="color:var(--jaco-text-muted);font-size:13px;margin:0 0 16px;">@Model.Subject</p>
        }
        <p style="color:var(--jaco-text-muted);font-size:12.5px;margin:0 0 16px;">This confirms the decision -- it isn't applied just by opening this page.</p>
        <form method="post" action="~/EmailAction/ApproveConfirm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@Model.Token" />
            <div style="display:flex;gap:10px;">
                <button type="submit" class="jaco-btn jaco-btn-primary" style="flex:1;justify-content:center;">Confirm Approve</button>
                <a class="jaco-btn jaco-btn-outline" href="~/">Cancel</a>
            </div>
        </form>
    </div>
</body>
</html>
