@model ApprovalType
@{ ViewData["Title"] = "Edit Approval Type"; }
<a class="jaco-back-link" href="/ApprovalTypes">&larr; Back to Approval Types</a>
<div class="jaco-page-header"><div><h1>Edit @Model.Name</h1></div></div>
<form method="post" action="/ApprovalTypes/Edit/@Model.Id" class="jaco-card jaco-card-pad" style="max-width:560px;">
    @Html.AntiForgeryToken()
    <div class="jaco-form-group"><label>Code</label><input class="jaco-input" name="Code" value="@Model.Code" style="text-transform:uppercase;" required /></div>
    <div class="jaco-form-group"><label>Name</label><input class="jaco-input" name="Name" value="@Model.Name" required /></div>
    <div class="jaco-form-group"><label>Description</label><textarea class="jaco-input" name="Description" rows="2">@Model.Description</textarea></div>
    <div class="jaco-check-row"><input type="checkbox" name="Active" value="true" checked="@Model.Active" id="active" /><label for="active" style="margin:0;font-weight:400;">Active</label></div>
    <div style="display:flex;gap:10px;margin-top:12px;">
        <button type="submit" class="jaco-btn jaco-btn-primary">Save</button>
        <a class="jaco-btn jaco-btn-outline" href="/ApprovalTypes">Cancel</a>
    </div>
</form>
