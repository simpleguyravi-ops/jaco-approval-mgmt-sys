@model ApprovalTypeJourneyViewModel
@{
    ViewData["Title"] = $"{Model.ApprovalType.Name} Journey";
    string? PpfBadge(string eventCode, string label)
    {
        if (!Model.PpfCountsByEvent.TryGetValue(eventCode, out var count)) return null;
        var text = string.IsNullOrEmpty(label) ? $"{count}" : $"{label} ({count})";
        return $"<span class=\"flow-ppf-badge\" title=\"{count} active Post-Processing rule(s) fire on '{eventCode}'\">&#9993; {text}</span>";
    }
}
<a class="jaco-back-link" href="~/ApprovalTypes">&larr; Back to Approval Types</a>
<div class="jaco-page-header">
    <div>
        <h1>@Model.ApprovalType.Name Journey</h1>
        <p>The full request lifecycle, computed from whatever Routing and Post-Processing Rules already exist for this type -- rules are still authored individually on their own pages; this only renders the resulting chain.</p>
    </div>
</div>
<div class="jaco-card jaco-card-pad">
    <div class="flow-diagram">
        <div class="flow-node flow-start">
            <div class="flow-node-title">Submitted</div>
            <div class="flow-ppf-badges">@Html.Raw(PpfBadge("Created", "Created"))@Html.Raw(PpfBadge("Resubmit", "Resubmit"))</div>
        </div>

        <div class="flow-connector">
            <span class="flow-connector-arrow">&darr;</span>
            @Html.Raw(PpfBadge("LevelPending", "LevelPending"))
        </div>
        <div class="flow-row">
            <div class="flow-node flow-level">
                <div class="flow-node-title">Routing chain runs</div>
                <div class="flow-node-sub">Levels + approvers, existing -- see Routing Rules for detail</div>
            </div>
            <div class="flow-branches">
                <div class="flow-branch flow-branch-reject">&rarr; Rejected @Html.Raw(PpfBadge("Rejected", ""))</div>
                <div class="flow-branch flow-branch-sentback">&rarr; Sent Back @Html.Raw(PpfBadge("SentBack", ""))</div>
            </div>
        </div>

        <div class="flow-connector"><span class="flow-connector-arrow">&darr;</span></div>
        <div class="flow-node flow-end">
            <div class="flow-node-title">Approved</div>
            <div class="flow-ppf-badges">@Html.Raw(PpfBadge("Approved", "Approved"))@Html.Raw(PpfBadge("Completed", "Completed"))</div>
        </div>

        @if (Model.AssignTaskRuleCount > 0)
        {
            <div class="flow-connector"><span class="flow-connector-arrow">&darr;</span></div>
            <div class="flow-node flow-task">
                <div class="flow-node-title">Task assigned</div>
                <div class="flow-node-sub">@Model.AssignTaskRuleCount active "Assign a task" rule(s)</div>
            </div>

            <div class="flow-row" style="justify-content:center;gap:24px;">
                <div class="flow-node flow-task-outcome">
                    <div class="flow-node-title">Task completed</div>
                    <div class="flow-ppf-badges">@Html.Raw(PpfBadge("TaskCompleted", "TaskCompleted"))</div>
                </div>
                <div class="flow-node flow-task-outcome flow-task-overdue">
                    <div class="flow-node-title">Task overdue</div>
                    <div class="flow-node-sub">Repeats daily until done</div>
                    <div class="flow-ppf-badges">@Html.Raw(PpfBadge("TaskOverdue", "TaskOverdue"))</div>
                </div>
            </div>
        }
    </div>
</div>

<style>
.flow-diagram { max-width: 640px; margin: 0 auto; }
.flow-node { border: 1.5px solid var(--jaco-border); border-radius: var(--jaco-radius-md); padding: 14px 18px; background: var(--jaco-card); }
.flow-start, .flow-end, .flow-task, .flow-task-outcome { text-align: center; }
.flow-start { border-color: var(--jaco-info); }
.flow-end { border-color: var(--jaco-success); background: var(--jaco-success-bg); }
.flow-task { border-color: var(--jaco-orange-600); }
.flow-task-outcome { flex: 1; }
.flow-task-overdue { border-color: var(--jaco-warning); }
.flow-node-title { font-weight: 700; font-size: 14px; }
.flow-node-sub { font-size: 12px; color: var(--jaco-text-muted); margin-top: 2px; }
.flow-connector { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 6px 0; }
.flow-connector-arrow { font-size: 20px; color: var(--jaco-text-muted); line-height: 1; }
.flow-row { display: flex; align-items: flex-start; gap: 16px; }
.flow-level { flex: 1; min-width: 0; }
.flow-branches { display: flex; flex-direction: column; gap: 6px; flex-shrink: 0; padding-top: 4px; }
.flow-branch { font-size: 11.5px; font-weight: 600; white-space: nowrap; display: flex; align-items: center; gap: 5px; }
.flow-branch-reject { color: var(--jaco-danger); }
.flow-branch-sentback { color: var(--jaco-warning); }
.flow-ppf-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; background: var(--jaco-info-bg); color: var(--jaco-info); border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
.flow-ppf-badges { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin-top: 8px; min-height: 0; }
</style>
