@model List<PpfRuleListItem>
@{
    ViewData["Title"] = "Post-Processing Rules";
    var sort = (string?)ViewBag.Sort;
    var dir = (string)ViewBag.Dir;
    string SortUrl(string field)
    {
        var newDir = sort == field && dir == "asc" ? "desc" : "asc";
        return $"{Context.Request.PathBase}/PostProcessingRules?sort={field}&dir={newDir}";
    }
    string SortArrow(string field) => sort != field ? "" : (dir == "asc" ? " &#9650;" : " &#9660;");
}
<a class="jaco-back-link" asp-controller="Admin" asp-action="Index">&larr; Back to Administration</a>
<div class="jaco-page-header">
    <div><h1>Post-Processing Rules</h1><p>What fires -- an email or an API call -- when an event happens on a request, for whichever Approval Type(s) the rule applies to.</p></div>
    <a class="jaco-btn jaco-btn-primary" href="~/PostProcessingRules/Create">+ New Rule</a>
</div>
<div style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:8px;">
    <a class="jaco-btn jaco-btn-outline jaco-btn-sm" href="~/PostProcessingRules/Export">Download CSV</a>
    <a class="jaco-btn jaco-btn-outline jaco-btn-sm" href="~/ConfigSync/Export" title="Downloads this rule AND every Mail Template as one file -- rules reference templates by name, so the two travel together.">Download Config JSON</a>
    <a class="jaco-btn jaco-btn-outline jaco-btn-sm" href="~/ConfigSync">Upload Config JSON</a>
</div>
<p style="font-size:12.5px;color:var(--jaco-text-muted);margin:-4px 0 12px;">"Download CSV" above is a read-only summary. To move these rules (and their Mail Templates) to another environment -- e.g. testing here in Dev/QA, then promoting to Production -- use <b>Config Sync</b>: it round-trips the real rule config and template bodies as JSON, matching existing items by name so re-running it is safe to repeat.</p>
<div class="jaco-card">
    <table class="jaco-table">
        <thead><tr>
            <th><a class="link" href="@SortUrl("Name")">Name@(Html.Raw(SortArrow("Name")))</a></th>
            <th><a class="link" href="@SortUrl("ApprovalType")">Applies To@(Html.Raw(SortArrow("ApprovalType")))</a></th>
            <th><a class="link" href="@SortUrl("Event")">Event@(Html.Raw(SortArrow("Event")))</a></th>
            <th>Then</th>
            <th><a class="link" href="@SortUrl("Recipient")">Recipient@(Html.Raw(SortArrow("Recipient")))</a></th>
            <th>Criteria</th>
            <th>Attachments</th>
            <th><a class="link" href="@SortUrl("Status")">Status@(Html.Raw(SortArrow("Status")))</a></th>
        </tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><a class="link" href="~/PostProcessingRules/Edit/@r.Id">@r.Name</a></td>
                <td>@r.ApprovalTypeNames</td>
                <td>@r.EventCode</td>
                <td>@(r.ActionType switch { "ApiCall" => "Call an API", "AssignTask" => "Assign a task: " + r.TemplateName, _ => "Email: " + r.TemplateName })</td>
                <td>@(r.ActionType is "ApiCall" or "AssignTask" ? "-" : r.ToMode)</td>
                <td>@(r.CriteriaCount == 0 ? "Always" : $"{r.CriteriaCount} condition(s)")</td>
                <td>@(r.IncludeAttachments ? "Yes" : "–")</td>
                <td>
                    @if (r.Active) { <span class="jaco-badge jaco-badge-success">ACTIVE</span> }
                    else { <span class="jaco-badge jaco-badge-neutral">DISABLED</span> }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="8" style="text-align:center;color:var(--jaco-text-muted);">No post-processing rules yet.</td></tr>
        }
        </tbody>
    </table>
</div>
