@using JACO.Unified.Core.Models
@model List<DigestRunRecipient>
@{
    ViewData["Title"] = "Digest Run Detail";
    var run = (DigestRun)ViewBag.Run;
}
<a class="jaco-back-link" asp-controller="Cockpit" asp-action="DigestLog">&larr; Back to Digest Log</a>
<div class="jaco-page-header">
    <div>
        <h1>@run.ApprovalTypeName Digest &mdash; @run.RunAtUtc.ToString("dd MMM yyyy HH:mm:ss") UTC</h1>
        <p>Triggered @run.TriggeredBy.ToLowerInvariant()@(run.TriggeredByUserName is null ? "" : $" by {run.TriggeredByUserName}") &middot; @run.EligibleUserCount active user(s) considered &middot; @run.RecipientCount had pending items &middot; @run.SentCount sent, @run.FailedCount failed.</p>
    </div>
</div>

<div class="jaco-card">
    <table class="jaco-table">
        <thead><tr>
            <th>User</th>
            <th>Email</th>
            <th>Pending Items</th>
            <th>Status</th>
            <th>Content</th>
        </tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.UserName</td>
                <td>@(r.Email ?? "—")</td>
                <td>@r.PendingCount</td>
                <td>
                    @if (r.Status == "Sent") { <span class="jaco-badge jaco-badge-success">SENT</span> }
                    else { <span class="jaco-badge jaco-badge-danger" title="@r.ErrorMessage">FAILED</span> }
                    @if (r.Status != "Sent" && !string.IsNullOrEmpty(r.ErrorMessage))
                    {
                        <div style="font-size:11.5px;color:var(--jaco-text-muted);margin-top:2px;">@r.ErrorMessage</div>
                    }
                </td>
                <td>
                    <details>
                        <summary style="cursor:pointer;color:var(--jaco-orange-600);font-size:12.5px;font-weight:600;">View</summary>
                        <div style="margin-top:6px;font-size:12px;max-width:480px;">
                            <div style="color:var(--jaco-text-muted);font-weight:600;">Subject</div>
                            <div style="background:var(--jaco-bg);border-radius:4px;padding:6px 8px;margin:2px 0 8px;">@r.Subject</div>
                            <div style="color:var(--jaco-text-muted);font-weight:600;">Body</div>
                            <div style="border:1px solid var(--jaco-border);border-radius:4px;padding:8px;margin:2px 0;max-height:320px;overflow:auto;">@Html.Raw(r.BodyHtml)</div>
                        </div>
                    </details>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" style="text-align:center;color:var(--jaco-text-muted);">No recipients had pending items for this run.</td></tr>
        }
        </tbody>
    </table>
</div>
