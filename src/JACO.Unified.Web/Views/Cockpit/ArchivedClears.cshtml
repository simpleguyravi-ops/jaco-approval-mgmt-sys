@model List<LogArchive>
@{
    ViewData["Title"] = "Operations Cockpit";
    var filter = (LogArchiveFilter)ViewBag.Filter;
    var totalCount = (int)ViewBag.TotalCount;
    var pageSize = (int)ViewBag.PageSize;
    var logTypes = new[] { "RoutingLog", "AuditLog", "ApiRequestLog", "DigestLog" };
    string LogTypeLabel(string t) => t switch { "RoutingLog" => "Routing Log", "AuditLog" => "Audit Log", "ApiRequestLog" => "API Request Log", "DigestLog" => "Digest Log", _ => t };
}
<a class="jaco-back-link" asp-controller="Admin" asp-action="Index">&larr; Back to Administration</a>
<div class="jaco-page-header">
    <div><h1>Operations Cockpit</h1><p>Recovery copies written by every "Clear Old Entries" action, before anything was deleted &mdash; download one back if a Clear turns out to have been a mistake.</p></div>
</div>

<div class="lookup-tabs" style="margin-bottom:16px;">
    <a class="lookup-tab" asp-controller="Cockpit" asp-action="RoutingLog">Routing / Determination Log</a>
    <a class="lookup-tab" asp-controller="Cockpit" asp-action="AuditLog">Request Audit Log</a>
    <a class="lookup-tab" asp-controller="Cockpit" asp-action="ApiRequestLog">API Request Log</a>
    <a class="lookup-tab" asp-controller="Cockpit" asp-action="DigestLog">Digest Log</a>
    <a class="lookup-tab selected" asp-controller="Cockpit" asp-action="ArchivedClears">Archived Clears</a>
</div>

<div class="jaco-card jaco-card-pad" style="margin-bottom:16px;">
    <form method="get" action="~/Cockpit/ArchivedClears" style="display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;max-width:420px;">
        <div class="jaco-form-group" style="margin:0;">
            <label>Log Type</label>
            <select name="LogType" class="jaco-select">
                <option value="">(all)</option>
                @foreach (var t in logTypes) { <option value="@t" selected="@(filter.LogType == t)">@LogTypeLabel(t)</option> }
            </select>
        </div>
        <button type="submit" class="jaco-btn jaco-btn-primary">Filter</button>
    </form>
</div>

<span style="font-size:12.5px;color:var(--jaco-text-muted);">Showing @Model.Count of @totalCount matching entries@(totalCount > pageSize ? $" (most recent {pageSize})" : "").</span>

<div class="jaco-card" style="margin-top:8px;">
    <table class="jaco-table">
        <thead><tr>
            <th>Cleared At (UTC)</th><th>Log Type</th><th>Entries Older Than</th><th>Entry Count</th><th>Cleared By</th><th></th>
        </tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.ClearedAt.ToString("dd MMM yyyy HH:mm:ss")</td>
                <td><span class="jaco-badge jaco-badge-info">@LogTypeLabel(a.LogType)</span></td>
                <td>@a.BeforeDate.ToString("dd MMM yyyy")</td>
                <td>@a.EntryCount</td>
                <td>@(a.ClearedByUserName ?? "—")</td>
                <td><a class="jaco-btn jaco-btn-outline jaco-btn-sm" asp-controller="Cockpit" asp-action="DownloadLogArchive" asp-route-id="@a.Id">Download</a></td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" style="text-align:center;color:var(--jaco-text-muted);">No Clear actions have been run yet.</td></tr>
        }
        </tbody>
    </table>
</div>
