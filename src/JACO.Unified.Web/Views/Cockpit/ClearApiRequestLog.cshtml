@model ClearLogsResult
@{ ViewData["Title"] = "Clear API Request Log"; }
<a class="jaco-back-link" asp-controller="Cockpit" asp-action="ApiRequestLog">&larr; Back to API Request Log</a>
<div class="jaco-page-header">
    <div><h1>Clear API Request Log</h1><p>Removes API request log entries older than the date below from the live log. Every entry is archived first &mdash; see <a class="link" asp-controller="Cockpit" asp-action="ArchivedClears">Archived Clears</a> to download it back.</p></div>
</div>

<div class="jaco-card jaco-card-pad" style="max-width:480px;">
    <form method="get" asp-controller="Cockpit" asp-action="ClearApiRequestLog">
        <div class="jaco-form-group"><label>Delete entries older than</label><input type="date" name="beforeDate" value="@(Model.BeforeDate?.ToString("yyyy-MM-dd"))" max="@Model.MaxAllowedBeforeDate.ToString("yyyy-MM-dd")" class="jaco-input" required /></div>
        <button type="submit" class="jaco-btn jaco-btn-outline">Preview Count</button>
    </form>
    @if (Model.IsProduction)
    {
        <p style="margin-top:10px;color:var(--jaco-text-muted);font-size:12.5px;">System is in <strong>Production</strong> mode. Minimum retention policy: entries newer than <strong>@Model.MaxAllowedBeforeDate.ToString("dd MMM yyyy")</strong> can't be cleared, regardless of the date picked.</p>
    }
    else
    {
        <p style="margin-top:10px;color:var(--jaco-text-muted);font-size:12.5px;">System is in <strong>Test</strong> mode &mdash; the minimum retention policy is relaxed. <a class="link" asp-controller="SystemSettings" asp-action="Index">Switch to Production</a> before go-live.</p>
    }

    @if (Model.BeforeDate is null)
    {
        <p style="margin-top:16px;color:var(--jaco-text-muted);font-size:13px;">Pick a date and preview how many entries that would delete before anything is removed. There is no default range &mdash; nothing is deleted until you choose one.</p>
    }
    else if (Model.ExceedsMinRetention)
    {
        <div class="jaco-alert" style="margin-top:16px;background:var(--jaco-danger-bg);color:var(--jaco-danger);">
            <strong>@Model.BeforeDate.Value.ToString("dd MMM yyyy")</strong> is within the @(DateTime.UtcNow.Date.Subtract(Model.MaxAllowedBeforeDate.Date).Days)-day minimum retention window. Choose a date on or before <strong>@Model.MaxAllowedBeforeDate.ToString("dd MMM yyyy")</strong>.
        </div>
        <a class="jaco-btn jaco-btn-outline" style="margin-top:12px;" asp-controller="Cockpit" asp-action="ApiRequestLog">Back</a>
    }
    else
    {
        <div class="jaco-alert" style="margin-top:16px;background:var(--jaco-warning-bg);color:var(--jaco-warning);">
            <strong>@Model.MatchingCount</strong> entr@(Model.MatchingCount == 1 ? "y" : "ies") dated before <strong>@Model.BeforeDate.Value.ToString("dd MMM yyyy")</strong> will be archived, then removed from the live log.
        </div>
        @if (Model.MatchingCount > 0)
        {
            <form method="post" asp-controller="Cockpit" asp-action="ClearApiRequestLogConfirmed" style="margin-top:12px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="beforeDate" value="@Model.BeforeDate.Value.ToString("yyyy-MM-dd")" />
                <button type="submit" class="jaco-btn" style="background:var(--jaco-danger);color:#fff;border-color:var(--jaco-danger);">Archive &amp; Delete @Model.MatchingCount Entries</button>
                <a class="jaco-btn jaco-btn-outline" asp-controller="Cockpit" asp-action="ApiRequestLog">Cancel</a>
            </form>
        }
        else
        {
            <a class="jaco-btn jaco-btn-outline" style="margin-top:12px;" asp-controller="Cockpit" asp-action="ApiRequestLog">Back</a>
        }
    }
</div>
